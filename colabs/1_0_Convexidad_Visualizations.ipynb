## 📊 6. Descenso de Gradiente: El GPS de la Optimización

### 🖼️ Animación del Descenso de Gradiente

```python
# @title Animación: Descenso de Gradiente

def gradient_descent_animation():
    # Función: f(x) = x^4 - 4x^3 + 4x^2 + x
    x = np.linspace(-1, 4.5, 400)
    y = x**4 - 4*x**3 + 4*x**2 + x
    
    # Gradiente
    dy = 4*x**3 - 12*x**2 + 8*x + 1
    
    # Punto inicial
    x0 = 4.0
    
    # Descenso de gradiente
    learning_rate = 0.01
    iterations = 100
    x_path = [x0]
    
    for _ in range(iterations):
        grad = 4*x0**3 - 12*x0**2 + 8*x0 + 1
        x0 = x0 - learning_rate * grad
        x_path.append(x0)
    
    # Crear animación
    fig, ax = plt.subplots(figsize=(12, 6))
    ax.plot(x, y, 'b-', linewidth=2, label='f(x) = x⁴ - 4x³ + 4x² + x')
    ax.set_xlim(-0.5, 4.5)
    ax.set_ylim(-1, 10)
    ax.set_xlabel('x')
    ax.set_ylabel('f(x)')
    ax.set_title('Descenso de Gradiente: Encontrando el Óptimo')
    ax.grid(True, alpha=0.3)
    ax.legend()
    
    # Punto inicial
    point, = ax.plot([], [], 'ro', markersize=10, label='Punto actual')
    path, = ax.plot([], [], 'r--', linewidth=1, label='Trayectoria')
    
    def update(frame):
        if frame < len(x_path):
            current_x = x_path[frame]
            current_y = current_x**4 - 4*current_x**3 + 4*current_x**2 + current_x
            point.set_data([current_x], [current_y])
            path.set_data(x_path[:frame+1], [xi**4 - 4*xi**3 + 4*xi**2 + xi for xi in x_path[:frame+1]])
            ax.set_title(f'Descenso de Gradiente - Iteración {frame}')
        return point, path
    
    ani = animation.FuncAnimation(fig, update, frames=iterations+1, 
                                  interval=50, blit=True, repeat=False)
    
    plt.close()
    return HTML(ani.to_html5_video())

# Mostrar animación
HTML(gradient_descent_animation())

print("⬆️ Animación del descenso de gradiente en acción")
```

