## 🎯 3. Función de Soporte (Support Function)

**Referencia:** Handbook of Convex Geometry, Vol B, p. 365

La **función de soporte** $h_C(u)$ de un conjunto convexo $C$ se define como:
$$h_C(u) = \sup\{\langle u, x \rangle \mid x \in C\}$$

**Interpretación:** Es la distancia máxima en la dirección $u$ desde el origen hasta el conjunto.

### 🖼️ Visualización de la Función de Soporte

```python
# @title Función de Soporte de un Polígono
@interact

def plot_support_function(
    polygon_type=widgets.Dropdown(
        options=['Triángulo', 'Cuadrado', 'Pentágono', 'Hexágono', 'Círculo'],
        value='Cuadrado',
        description='Polígono:'
    ),
    direction=widgets.FloatSlider(
        min=0, max=2*np.pi, step=0.01, value=0,
        description='Dirección (rad):'
    )
):
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))
    
    # Crear polígono
    if polygon_type == 'Círculo':
        theta = np.linspace(0, 2*np.pi, 100)
        vertices = np.column_stack([np.cos(theta), np.sin(theta)])
        polygon = Circle((0, 0), 1, fill=True, alpha=0.3, color='blue', edgecolor='blue')
        ax1.add_patch(polygon)
        
    else:
        n_sides = {'Triángulo': 3, 'Cuadrado': 4, 'Pentágono': 5, 'Hexágono': 6}[polygon_type]
        theta = np.linspace(0, 2*np.pi, n_sides + 1)[:-1]
        vertices = np.column_stack([np.cos(theta), np.sin(theta)])
        polygon = Polygon(vertices, closed=True, fill=True, alpha=0.3, 
                         color='blue', edgecolor='blue')
        ax1.add_patch(polygon)
    
    # Dibujar polígono
    ax1.scatter(vertices[:, 0], vertices[:, 1], color='red', s=50, zorder=5)
    ax1.set_xlim(-1.5, 1.5)
    ax1.set_ylim(-1.5, 1.5)
    ax1.set_aspect('equal')
    ax1.grid(True, alpha=0.3)
    ax1.set_xlabel('$x_1$')
    ax1.set_ylabel('$x_2$')
    ax1.set_title(f'Conjunto Convexo: {polygon_type}')
    
    # Vector dirección
    u = np.array([np.cos(direction), np.sin(direction)])
    ax1.quiver(0, 0, u[0], u[1], angles='xy', scale_units='xy', 
              scale=1, color='green', linewidth=3, label=f'u = ({u[0]:.2f}, {u[1]:.2f})')
    
    # Calcular función de soporte
    if polygon_type == 'Círculo':
        h = 1.0  # Radio
    else:
        h = np.max(np.dot(vertices, u))
    
    # Dibujar línea en dirección u
    t = np.linspace(0, h, 100)
    ax1.plot(t * u[0], t * u[1], 'g--', linewidth=2)
    ax1.scatter(h * u[0], h * u[1], color='green', s=100, zorder=5, 
                label=f'h(u) = {h:.3f}')
    
    ax1.legend()
    
    # Gráfico de la función de soporte
    directions = np.linspace(0, 2*np.pi, 200)
    support_values = []
    
    for d in directions:
        u_dir = np.array([np.cos(d), np.sin(d)])
        if polygon_type == 'Círculo':
            support_values.append(1.0)
        else:
            support_values.append(np.max(np.dot(vertices, u_dir)))
    
    ax2.plot(directions, support_values, color='purple', linewidth=3)
    ax2.set_xlabel('Dirección (radianes)')
    ax2.set_ylabel('h(u) = Función de Soporte')
    ax2.set_title('Función de Soporte: h(u) = sup⟨u, x⟩')
    ax2.grid(True, alpha=0.3)
    
    # Marcar dirección actual
    ax2.scatter(direction, h, color='red', s=100, zorder=5, 
                label=f'Dirección actual')
    ax2.legend()
    
    plt.tight_layout()
    plt.show()

print("⬆️ Ejecuta para explorar la función de soporte de diferentes polígonos")
```

