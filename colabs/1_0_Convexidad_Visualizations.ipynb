## 🎯 5. Óptimo Global: El Tesoro en el Paisaje Convexo

### 🖼️ Visualización 3D de Optimización Convexa

```python
# @title Paisaje de Optimización: Convexo vs No-Convexo
@interact

def plot_optimization_landscape(
    landscape_type=widgets.Dropdown(
        options=['Convexo: Cuadrática', 'Convexo: Exponencial', 
                 'No-Convexo: Polinomial', 'No-Convexo: Trigonométrico'],
        value='Convexo: Cuadrática',
        description='Paisaje:'
    )
):
    fig = go.Figure()
    
    x = np.linspace(-5, 5, 100)
    y = np.linspace(-5, 5, 100)
    X, Y = np.meshgrid(x, y)
    
    if landscape_type == 'Convexo: Cuadrática':
        Z = X**2 + Y**2
        title = 'Paisaje Convexo: f(x,y) = x² + y²'
        
    elif landscape_type == 'Convexo: Exponencial':
        Z = np.exp(X**2 + Y**2) * 0.1
        title = 'Paisaje Convexo: f(x,y) = 0.1 * exp(x² + y²)'
        
    elif landscape_type == 'No-Convexo: Polinomial':
        Z = X**4 - 5*X**2 + Y**4 - 5*Y**2
        title = 'Paisaje No-Convexo: f(x,y) = x⁴ - 5x² + y⁴ - 5y²'
        
    elif landscape_type == 'No-Convexo: Trigonométrico':
        Z = np.sin(X) * np.cos(Y) * 10
        title = 'Paisaje No-Convexo: f(x,y) = 10 * sin(x) * cos(y)'
    
    # Crear superficie
    fig.add_trace(go.Surface(
        z=Z, x=X, y=Y,
        colorscale='Viridis',
        opacity=0.8,
        name='Función'
    ))
    
    # Encontrar y marcar óptimos locales
    if 'Convexo' in landscape_type:
        # Para convexos, hay un único mínimo
        fig.add_trace(go.Scatter3d(
            x=[0], y=[0], z=[Z[50, 50]],
            mode='markers',
            marker=dict(size=10, color='red'),
            name='Óptimo Global'
        ))
    else:
        # Para no-convexos, marcar varios óptimos
        # (Simplificación: marcamos puntos críticos)
        if landscape_type == 'No-Convexo: Polinomial':
            fig.add_trace(go.Scatter3d(
                x=[-np.sqrt(2.5), 0, np.sqrt(2.5)], 
                y=[-np.sqrt(2.5), 0, np.sqrt(2.5)], 
                z=[Z[25, 25], Z[50, 50], Z[25, 75]],
                mode='markers',
                marker=dict(size=10, color='red'),
                name='Óptimos Locales'
            ))
        else:
            fig.add_trace(go.Scatter3d(
                x=[-np.pi/2, np.pi/2], 
                y=[0, 0], 
                z=[10, 10],
                mode='markers',
                marker=dict(size=10, color='red'),
                name='Óptimos Locales'
            ))
    
    fig.update_layout(
        title=title,
        scene=dict(
            xaxis_title='x₁',
            yaxis_title='x₂',
            zaxis_title='f(x₁, x₂)',
            camera_eye=dict(x=1.5, y=1.5, z=0.8)
        ),
        height=600
    )
    
    fig.show()

print("⬆️ Ejecuta para explorar diferentes paisajes de optimización en 3D")
```

