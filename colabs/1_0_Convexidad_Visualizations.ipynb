## 📐 1. Conjuntos Convexos: La Prueba Visual

### 🎯 Definición
Un conjunto $C$ es **convexo** si para cualquier par de puntos $\mathbf{x}, \mathbf{y} \in C$ y cualquier $\lambda \in [0,1]$:
$$\lambda \mathbf{x} + (1-\lambda) \mathbf{y} \in C$$

**En palabras:** La línea recta entre cualquier par de puntos **se queda dentro** del conjunto.

### 🖼️ Visualización Interactiva

```python
# @title Conjuntos Convexos vs No-Convexos
@interact

def plot_convex_sets(set_type=widgets.Dropdown(
    options=['Círculo (Convexo)', 'Elipse (Convexo)', 'Polígono Convexo', 
             'Media Luna (No-Convexo)', 'Estrella (No-Convexo)', 'Anillo (No-Convexo)'],
    value='Círculo (Convexo)',
    description='Tipo:'
)):
    fig, ax = plt.subplots(figsize=(10, 8))
    ax.set_xlim(-2, 2)
    ax.set_ylim(-2, 2)
    ax.set_aspect('equal')
    ax.grid(True, alpha=0.3)
    ax.set_xlabel('$x_1$')
    ax.set_ylabel('$x_2$')
    
    # Generar puntos de prueba
    test_points = [(-1.5, -1), (1.5, 1), (-1, 1.5), (1, -1.5)]
    
    if set_type == 'Círculo (Convexo)':
        # Círculo unitario
        theta = np.linspace(0, 2*np.pi, 200)
        x = np.cos(theta)
        y = np.sin(theta)
        ax.fill(x, y, alpha=0.3, color='green')
        ax.plot(x, y, color='green', linewidth=2)
        ax.set_title('Conjunto Convexo: Círculo', color='green')
        
    elif set_type == 'Elipse (Convexo)':
        # Elipse
        theta = np.linspace(0, 2*np.pi, 200)
        x = 1.5 * np.cos(theta)
        y = np.sin(theta)
        ax.fill(x, y, alpha=0.3, color='green')
        ax.plot(x, y, color='green', linewidth=2)
        ax.set_title('Conjunto Convexo: Elipse', color='green')
        
    elif set_type == 'Polígono Convexo':
        # Hexágono regular
        theta = np.linspace(0, 2*np.pi, 7)[:-1]
        x = np.cos(theta)
        y = np.sin(theta)
        polygon = Polygon(np.column_stack([x, y]), closed=True, 
                         fill=True, alpha=0.3, color='green', edgecolor='green')
        ax.add_patch(polygon)
        ax.set_title('Conjunto Convexo: Hexágono', color='green')
        
    elif set_type == 'Media Luna (No-Convexo)':
        # Media luna (unión de dos círculos)
        theta1 = np.linspace(0, np.pi, 100)
        x1 = np.cos(theta1)
        y1 = np.sin(theta1)
        
        theta2 = np.linspace(np.pi, 2*np.pi, 100)
        x2 = np.cos(theta2) + 0.5
        y2 = np.sin(theta2)
        
        ax.fill(x1, y1, alpha=0.3, color='red')
        ax.fill(x2, y2, alpha=0.3, color='red')
        ax.plot(x1, y1, color='red', linewidth=2)
        ax.plot(x2, y2, color='red', linewidth=2)
        ax.set_title('Conjunto No-Convexo: Media Luna', color='red')
        
        # Dibujar línea que sale del conjunto
        ax.plot([-1, 1.5], [0, 0], 'b--', linewidth=2, label='Línea fuera del conjunto')
        ax.legend()
        
    elif set_type == 'Estrella (No-Convexo)':
        # Estrella de 5 puntas
        theta = np.linspace(0, 2*np.pi, 6)[:-1]
        outer_radius = 1.5
        inner_radius = 0.6
        
        x_outer = outer_radius * np.cos(theta)
        y_outer = outer_radius * np.sin(theta)
        x_inner = inner_radius * np.cos(theta + np.pi/5)
        y_inner = inner_radius * np.sin(theta + np.pi/5)
        
        x_star = np.concatenate([x_outer, x_inner[::-1]])
        y_star = np.concatenate([y_outer, y_inner[::-1]])
        
        star = Polygon(np.column_stack([x_star, y_star]), closed=True,
                       fill=True, alpha=0.3, color='red', edgecolor='red')
        ax.add_patch(star)
        ax.set_title('Conjunto No-Convexo: Estrella', color='red')
        
        # Dibujar línea que sale
        ax.plot([-1.5, 1.5], [0, 0], 'b--', linewidth=2, label='Línea fuera')
        ax.legend()
        
    elif set_type == 'Anillo (No-Convexo)':
        # Anillo (región entre dos círculos)
        theta = np.linspace(0, 2*np.pi, 200)
        x_outer = np.cos(theta)
        y_outer = np.sin(theta)
        x_inner = 0.5 * np.cos(theta)
        y_inner = 0.5 * np.sin(theta)
        
        ax.fill(x_outer, y_outer, alpha=0.3, color='red')
        ax.fill(x_inner, y_inner, alpha=1, color='white', edgecolor='red')
        ax.plot(x_outer, y_outer, color='red', linewidth=2)
        ax.plot(x_inner, y_inner, color='red', linewidth=2)
        ax.set_title('Conjunto No-Convexo: Anillo', color='red')
        
        # Dibujar línea que sale
        ax.plot([-1, 1], [0, 0], 'b--', linewidth=2, label='Línea fuera')
        ax.legend()
    
    # Dibujar puntos de prueba
    for x, y in test_points:
        ax.scatter(x, y, color='black', s=50, zorder=5)
    
    plt.tight_layout()
    plt.show()

print("⬆️ Ejecuta la celda para interactuar con los conjuntos")
```

