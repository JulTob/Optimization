## 🔍 4. Conjunto Factible: Restricciones que Esculpen

**Referencia:** Conecta con el capítulo A.4-Restricciones.md

### 🖼️ Visualización Interactiva del Conjunto Factible

```python
# @title Conjunto Factible con Restricciones Lineales
@interact

def plot_feasible_region(
    budget=widgets.FloatSlider(min=5, max=20, step=0.5, value=10, description='Presupuesto:'),
    capacity=widgets.FloatSlider(min=3, max=15, step=0.5, value=6, description='Capacidad:'),
    price_x=widgets.FloatSlider(min=0.5, max=5, step=0.1, value=2, description='Precio x₁:'),
    price_y=widgets.FloatSlider(min=0.5, max=5, step=0.1, value=1, description='Precio x₂:')
):
    fig, ax = plt.subplots(figsize=(10, 8))
    
    # Límites
    x = np.linspace(0, 15, 400)
    
    # Restricción de presupuesto: price_x * x1 + price_y * x2 <= budget
    y_budget = (budget - price_x * x) / price_y
    
    # Restricción de capacidad: x1 + x2 <= capacity
    y_capacity = capacity - x
    
    # Región factible
    y_feasible = np.minimum(y_budget, y_capacity)
    y_feasible[y_feasible < 0] = 0
    
    # Dibujar restricciones
    ax.plot(x, y_budget, 'r--', linewidth=2, label=f'Presupuesto: {price_x}x₁ + {price_y}x₂ ≤ {budget}')
    ax.plot(x, y_capacity, 'g--', linewidth=2, label=f'Capacidad: x₁ + x₂ ≤ {capacity}')
    
    # Rellenar región factible
    ax.fill_between(x, 0, y_feasible, where=(y_feasible >= 0), 
                   color='lightblue', alpha=0.5, label='Región Factible')
    
    # Vértices de la región factible
    intersection_x = (budget - price_y * capacity) / (price_x - price_y) if price_x != price_y else 0
    intersection_y = capacity - intersection_x
    
    if 0 <= intersection_x <= budget/price_x and 0 <= intersection_y <= budget/price_y:
        vertices = [
            (0, 0),
            (budget/price_x, 0),
            (intersection_x, intersection_y),
            (0, capacity)
        ]
    else:
        vertices = [(0, 0), (budget/price_x, 0), (0, min(budget/price_y, capacity))]
    
    # Dibujar vértices
    for vx, vy in vertices:
        ax.scatter(vx, vy, color='red', s=100, zorder=5)
    
    ax.set_xlim(0, 12)
    ax.set_ylim(0, 12)
    ax.set_xlabel('$x_1$ (Manzanas)')
    ax.set_ylabel('$x_2$ (Plátanos)')
    ax.set_title('Conjunto Factible: Intersección de Restricciones Lineales')
    ax.grid(True, alpha=0.3)
    ax.legend()
    
    plt.tight_layout()
    plt.show()

print("⬆️ Ejecuta para ver cómo las restricciones esculpen el conjunto factible")
```

